# Uploads/images directory - Allow images only, block everything else

# Allow image files
<FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|ico|bmp)$">
    Require all granted
</FilesMatch>

# Block PHP and all executable files
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|phar|exe|bin|bat|sh|pl|py)$">
    Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Set proper MIME types
AddType image/jpeg .jpg .jpeg
AddType image/png .png
AddType image/gif .gif
AddType image/webp .webp
AddType image/svg+xml .svg

# Force download for unknown types
<FilesMatch "\.(tiff|tif|psd|ai|eps)$">
    ForceType application/octet-stream
    Header set Content-Disposition attachment
</FilesMatch>
